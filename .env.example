# ==========================================
# SENTINEL-X Environment Configuration Template
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (MongoDB Atlas Free Tier)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=sentinel_x

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
